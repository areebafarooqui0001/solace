# Pick ONE provider. Gemini has a free tier. Claude is paid.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional. Models are picked automatically and fall back if Google retires one.
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

# REQUIRED when deployed: any long random string (the server refuses to start on a host with this example value).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Deploying? Also set DB_PATH to a file on a persistent disk/volume (e.g. /data/solace.db), or accounts vanish on restart.
# DB_PATH=/data/solace.db
PORT=4000

# Optional: Google sign-in. Comma-separated OAuth client IDs the app is allowed to sign in with (the Android client ID).
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# Optional: a ready-made demo login that is recreated at startup if missing (handy on free hosting that wipes data).
# DEMO_EMAIL=demo@solace.app
# DEMO_PASSWORD=choose-a-password
